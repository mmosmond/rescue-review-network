@article{ WOS:001077553900001,
Author = {van Velzen, Ellen},
Title = {High importance of indirect evolutionary rescue in a small food web},
Journal = {ECOLOGY LETTERS},
Year = {2023},
Volume = {26},
Number = {12},
Pages = {2110-2121},
Month = {DEC},
Abstract = {Evolutionary rescue may allow species to survive environmental change,
   but how this mechanism operates in food webs is poorly understood. Here,
   the evolutionary rescue was investigated in a small model food web,
   systematically allowing the evolution of each single species in order to
   reveal how its adaptation affects the persistence of itself and others.
   The impact of evolution was highly species-specific and not necessarily
   positive: only one species, the specialist predator, consistently had a
   positive impact on overall persistence. Most strikingly, evolution
   overwhelmingly affected other species: rescue of others (indirect
   rescue) was far more frequent than self-rescue, and negative effects
   were nearly always indirect. This demonstrates that evolutionary rescue
   in food webs is inextricably bound up with species interactions, as the
   effects of evolution in one species ripple through the entire community.
   It is therefore critically important to consider the food web context in
   efforts to understand how species may survive global change.
   Research on evolutionary rescue has focused on species in isolation,
   which presents major limitations for understanding how evolution affects
   species' ability to survive global change in nature, where species are
   embedded in food webs. Here I use a small simulated food web to
   investigate how this context affects evolutionary rescue. The results
   show that the evolution of a focal species overwhelmingly affected the
   survival of others rather than its own survival, via changing trophic
   and competitive interactions.image},
