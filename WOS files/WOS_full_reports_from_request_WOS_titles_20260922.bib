@article{ WOS:A1977CX98200009,
	Author = {COMINS, HN},
	Title = {DEVELOPMENT OF INSECTICIDE RESISTANCE IN PRESENCE OF MIGRATION},
	Journal = {JOURNAL OF THEORETICAL BIOLOGY},
	Year = {1977},
	Volume = {64},
	Number = {1},
	Pages = {177-197},
	Abstract = {A model of insecticide resistance including migration is developed in
	order to try to understand the large variations in time required for
	insects to develop resistance. There is a critical migration rate above
	which resistance is greatly retarded. The model also suggests that
	density dependence is important in determining the optimal insecticide
	kill rate and that a larger kill rate will probably delay the onset of
	resistance.},
