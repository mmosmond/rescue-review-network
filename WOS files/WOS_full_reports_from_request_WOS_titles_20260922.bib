@article{ WOS:A19668953900007,
Author = {NISSENME.S},
Title = {ANALYSIS OF EFFECTS OF ANTIBIOTICS ON BACTERIA BY MEANS OF STOCHASTIC
   MODELS},
Journal = {BIOMETRICS},
Year = {1966},
Volume = {22},
Number = {4},
Pages = {761+},
Abstract = {A stochastic model is suggested for the development of drug-resistant
   bacteria in large populations of susceptible bacteria exposed to the
   drug according to various schemes. Analysis of such models might
   indicate treatment schemes for infectious diseases, which, subject to
   restrictions due to drug toxlcity, would minimize the risk of developing
   resistant bacteria. The model assumes that both types of bacteria are
   subject to simple birth-death processes. Exposure to the drug increases
   the death rate and/or decreases the birth rate of the susceptible
   bacteria, but does not affect the rates for the resistant bacteria. A
   resistant bacterium arises by mutation. The mutation rate is extremely
   small in relation to the other rates and is independent of the drug. An
   approximation, considered permissible for large populations of
   susceptible bacteria with very small mutation rates, was found necessary
   to obtain solutions applicable to real therapeutic problems. The
   approximation assumes that the probability of a mutation in a small time
   interval is proportional to the expected number of susceptible bacteria,
   instead of to the actual number. The resistant bacteria will then be
   subject to a birth-death process with a time-dependent feeding function,
   and formulas derived for the probability of their extinction may be used
   as measures of the effectiveness of the treatment. The main results of
   the analysis were: Interruptions in the administration of medication
   should be avoided. However, in periodic treatment schedules used in some
   chronic diseases, a large initial dose with subsequent gradual reduction
   seems preferable to a uniform distribution of doses over the period.},
