   Guengerich, F. Peter, Vanderbilt Univ, Sch Med, Dept Biochem, Nashville, TN 37232 USA.
   Vanderbilt Univ, Sch Med, Ctr Mol Toxicol, Nashville, TN 37232 USA.},
DOI = {10.1016/j.abb.2010.08.017},
ISSN = {0003-9861},
Keywords = {Cytochrome P450; Catalytic mechanisms; Kinetics; Carbonyl oxidation;
   Aromatase; Nitrosamines},
Keywords-Plus = {NUCLEAR MAGNETIC RESONANCE; REVERSIBLE HYDRATION; METABOLIC-ACTIVATION;
