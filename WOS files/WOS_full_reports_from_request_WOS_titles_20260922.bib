@article{ WOS:001016452300001,
Author = {Lazaro, Noelia and Ronda-Leal, Marina and Pineda, Antonio and Osman,
   Sameh M. and Shokouhimehr, Mohammadreza and Jang, Ho Won and Luque,
   Rafael},
Title = {One-pot multi-step synthesis of gamma-valerolactone from furfuryl
   alcohol: Microwave vs continuous flow reaction studies},
Journal = {FUEL},
Year = {2023},
Volume = {334},
Number = {1},
Month = {FEB 15},
Abstract = {Mesoporous materials Al-SBA-15 have been synthesized and functionalized
   with different Al/Zr molar ratio and 0.5\% Au and Ru, respectively, by a
   mechanochemical approach. Textural and structural properties of
   synthesized materials have been analysed by TEM (Transmission Electron
   Microscopy), SEM (Scanning Electron Microscopy), XPS (X-ray
   photoelectron spectroscopy), XRD (X-ray Diffraction) and N2
   adsorption/desorption technique, among others. The catalytic activity of
   synthesized materials has been evaluated in the one-pot conversion of
   furfuryl alcohol (FAL) employing 2-propanol as H-donor solvent to obtain
   \& gamma;-valerolactone (GVL), both under microwave-assisted irradiation
   (CEM Discover \& REG; 2.0) and continuous flow conditions (Phoenix Flow
   ReactorTM, ThalesNano). All materials displayed conversions up to 99\%,
   with a GVL selectivity of ca. 20-41\% after one-hour reaction time. The
   study of the reusability of the materials showed a good GVL production
   during 3 reaction cycles employing both microwave-assisted and flow
   reaction conditions.},
