@article{ WOS:000457829800003,
Author = {Kelly, Ella and Phillips, Ben},
Title = {How many and when? Optimising targeted gene flow for a step change in
   the environment},
Journal = {ECOLOGY LETTERS},
Year = {2019},
Volume = {22},
Number = {3},
Pages = {447-457},
Month = {MAR},
Abstract = {Targeted gene flow is an emerging conservation strategy that involves
   introducing individuals with particular traits to places where these
   traits are of benefit. One obvious application is to adapt a recipient
   population to a known threat, but questions remain as to how best to
   achieve this. Here, we vary timing and size of the introduction to
   maximise our objective - survival of the recipient population's genome.
   We explore a generic population model as well as a specific example -
   the northern quoll, an Australian marsupial predator threatened by the
   toxic cane toad. We reveal a trade-off between preserving the recipient
   genome and reducing population extinction risk, but key management
   levers can often optimise this so that nearly 100\% of the recipient
   population's genome is preserved. Any action was better than none but
   the size of the benefit was sensitive to outbreeding depression,
   recombination rate, and the timing and size of the introduction.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Kelly, E (Corresponding Author), Univ Melbourne, Sch Biosci, Parkville, Vic 3010, Australia.
   Kelly, Ella; Phillips, Ben, Univ Melbourne, Sch Biosci, Parkville, Vic 3010, Australia.},
DOI = {10.1111/ele.13201},
ISSN = {1461-023X},
EISSN = {1461-0248},
