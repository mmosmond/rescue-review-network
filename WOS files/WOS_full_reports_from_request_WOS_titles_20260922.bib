Volume = {77},
Number = {1},
Pages = {42-48},
Month = {FEB},
Abstract = {Inspired by previous work of Iwasa et al. (2006) and Haeno et al.
   (2007), we consider an exponentially growing population of cancerous
   cells that will evolve resistance to treatment after one mutation or
   display a disease phenotype after two or more mutations. We prove
   results about the distribution of the first time when k mutations have
   accumulated in some cell, and about the growth of the number of type-k
   cells. We show that our results can be used to derive the previous
   results about a tumor grown to a fixed size. (C) 2009 Elsevier Inc. All
