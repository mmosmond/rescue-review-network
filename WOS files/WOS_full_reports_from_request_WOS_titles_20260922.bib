@article{ WOS:A1983RH54800009,
Author = {COLDMAN, AJ and GOLDIE, JH},
Title = {A MODEL FOR THE RESISTANCE OF TUMOR-CELLS TO CANCER
   CHEMOTHERAPEUTIC-AGENTS},
Journal = {MATHEMATICAL BIOSCIENCES},
Year = {1983},
Volume = {65},
Number = {2},
Pages = {291-307},
Abstract = {A mathematical model of tumor resistance to chemotherapy based on a
   stochastic process of change is presented. The probability of no
   resistant cells is utilized as a fundamental quantity of interest, and
   the effects of various therapeutic strategies on it are explored.
   Situations where 1 or 2 drugs are available are treated in detail and
   extrapolation made to the n-drug case. The situation where 2 drugs may
   not be given simultaneously is examined, and it is found that sequential
   alternation of drugs satisfies certain optimality criteria when both
   drugs are equally effective. From this it is inferred that the
   simultaneous administration of all available active agents is optimal
   where this is permissible.},
