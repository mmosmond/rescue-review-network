@article{ WOS:A1982NE94800004,
Author = {GOLDIE, JH and COLDMAN, AJ and GUDAUSKAS, GA},
Title = {RATIONALE FOR THE USE OF ALTERNATING NON-CROSS-RESISTANT CHEMOTHERAPY},
Journal = {CANCER TREATMENT REPORTS},
Year = {1982},
Volume = {66},
Number = {3},
Pages = {439-449},
Abstract = {An argument is presented for examining the rationale for the use of
   alternating non-cross-resistant chemotherapy. It is assumed that the
   development of a double resistant human] tumor cell (i.e., a
   phenotype that is resistant to both arms of an alternating regimen) will
   result in incurability of the tumor. Thus, strategies that will minimize
   this risk can be expected to be the most effective. By means of a
   mathematical development and a computer program that simulates the
   process of doubly resistant cells appearing during treatment, it can be
   demonstrated that alternating the treatment regimen at every cycle will
   be the most effective strategy for a wide variety of cases.},
